# ----------------------------
# Phoenix Environment
# ----------------------------
MIX_ENV=dev
SECRET_KEY_BASE=GENERATE_WITH_mix_phx.gen.secret_64
LIVE_VIEW_SIGNING_SALT=GENERATE_WITH_mix_phx.gen.secret_32
GUARDIAN_SECRET_KEY=GENERATE_WITH_mix_guardian.gen.secret

# ----------------------------
# PostgreSQL Database
# ----------------------------
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=phoenixapp_dev
DATABASE_URL=postgresql://postgres:postgres@db:5432/phoenixapp_dev

# ----------------------------
# Redis
# ----------------------------
REDIS_URL=redis://redis:6379/0

# ----------------------------
# Mail (Mailhog in dev)
# ----------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=ted
SMTP_PASS=nugent

# ----------------------------
# CORS (for local UE5/frontend dev)
# ----------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ----------------------------
# Service Configuration
# ----------------------------
PHOENIX_SERVICE_URL=http://phoenix-web:4000

# Shared database (same as Phoenix)
# Your existing DATABASE_URL should work for both services