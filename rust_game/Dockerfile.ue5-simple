# Simplified UE5 Builder using existing UE5 Docker image
# This uses the community-maintained UE5 Docker images

FROM ghcr.io/epicgames/unreal-engine:5.4-runtime

# Install additional dependencies
USER root
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Switch back to UE5 user
USER ue4

# Set working directory
WORKDIR /project

# Copy build script
COPY --chown=ue4:ue4 build-simple.sh /usr/local/bin/
USER root
RUN chmod +x /usr/local/bin/build-simple.sh
USER ue4

# Default command
CMD ["/usr/local/bin/build-simple.sh"]