<div class="min-h-screen">
  <!-- Background rendering moved to root layout to avoid LiveView patches replacing the canvas -->
  <!-- Background preference logic temporarily disabled until migration adds DB columns -->
  
  <PhoenixAppWeb.Components.Navigation.navbar current_user={assigns[:current_user]} id_prefix="main-" />
  
  <.flash_group flash={@flash} />
  
  <!-- Phoenix Desktop (taskbar + windows) - renders for authenticated users -->
  <%= if assigns[:current_user] do %>
    <.live_component 
      module={PhoenixAppWeb.PhoenixDesktopLive} 
      id="phoenix-desktop"
      current_user={@current_user}
    />
  <% end %>
  
  <main class="relative z-10 w-full pb-12">
    <%= @inner_content %>
  </main>
</div>