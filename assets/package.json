{
  "repository": {},
  "description": " ",
  "license": "MIT",
  "dependencies": {
    "phoenix": "file:../deps/phoenix",
    "phoenix_html": "file:../deps/phoenix_html",
    "phoenix_live_view": "file:../deps/phoenix_live_view",
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.0.0",
    "@babylonjs/materials": "^8.0.0",
    "@babylonjs/gui": "^8.0.0",
    "@babylonjs/havok": "^1.0.0"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -c tailwind.config.js -i css/app.css -o ../priv/static/assets/app.css --minify",
    "build:js": "esbuild js/app.js --bundle --outdir=../priv/static/assets --external:/fonts/* --external:/images/* --format=iife --target=es2020 --minify --sourcemap --tree-shaking=true --loader:.ts=ts",
    "deploy": "npm run build && npm run copy:fonts",
    "copy:fonts": "mkdir -p ../priv/static/fonts && cp -r fonts/* ../priv/static/fonts/",
    "watch": "npm run watch:css & npm run watch:js",
    "watch:css": "tailwindcss -c tailwind.config.js -i css/app.css -o ../priv/static/assets/app.css --watch",
    "watch:js": "esbuild js/app.js --bundle --outdir=../priv/static/assets --external:/fonts/* --external:/images/* --watch --format=iife --target=es2020 --loader:.ts=ts"
  },
  "devDependencies": {
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.23",
    "@tailwindcss/forms": "^0.5.3",
    "esbuild": "^0.19.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
